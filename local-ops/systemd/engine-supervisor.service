# engine-supervisor -- coordinated restart of BOTH nodes on an abnormal engine exit.
# HEAD (spark-45ea) ONLY. Installed by local-ops/install-user-units.sh.
# The one standing exception to "ask before every restart" (2026-10-14),
# scoped to crash recovery. Planned work: `touch ~/.engine-hold` first.
#   journalctl --user -u engine-supervisor
[Unit]
Description=engine-supervisor -- coordinated two-node restart on an engine crash
After=network-online.target

[Service]
Type=simple
# WHICH ENGINE: ~/.config/engine-supervisor.env (ENGINE_LANE, SUPERVISOR_SRC)
# overrides these defaults. The defaults are PRODUCTION's lane, so a lost env
# file still recovers the right engine: 0.32 since 2026-10-18 (was 0.21), the
# only lane since 2026-10-19. ~/.config/systemd/user/engine-supervisor.service
# is a symlink to THIS file: re-point it before moving or deleting the checkout.
Environment=ENGINE_LANE=0.32
Environment=SUPERVISOR_SRC=%h/dspark032/local-ops/systemd/engine-supervisor.sh
EnvironmentFile=-%h/.config/engine-supervisor.env
# Run a COPY: a deploy push must never edit the script a running bash is reading.
ExecStartPre=/bin/cp -f ${SUPERVISOR_SRC} %t/engine-supervisor.sh
ExecStart=/bin/bash %t/engine-supervisor.sh
Restart=always
RestartSec=30
TimeoutStopSec=15
# *** NO NoNewPrivileges, NO PrivateTmp, and both are deliberate. *** The start
# script it runs uses `sudo -n sysctl vm.drop_caches=3` for the boot-time cache
# reclaim; NoNewPrivileges would make that sudo fail and the boot would quietly
# differ ("Startup cache reclaim: SKIPPED"). And the boot sentinel it honours is
# /tmp/dspark-booting, which a private /tmp would hide.

[Install]
WantedBy=default.target
