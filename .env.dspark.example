# DeepSeek V4 Flash DSpark C12 NVFP4 profile for 2x DGX Spark TP=2.
# Copy to .env.dspark on each node and adjust node-specific values.

# Cluster
WORKER_HOST=worker-host-or-roce-ip
# Worker-local checkout/deployment path. Leave blank to mirror the head path.
WORKER_DIR=
# Optional explicit worker checkout path. This is useful when the worker clone
# lives somewhere different from the head checkout; it takes precedence over
# WORKER_DIR when set.
WORKER_SCRIPT_DIR=
MASTER_ADDR=head-roce-ip
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=

# Worker node should use:
# NODE_RANK=1
# HEADLESS=1

# RoCE / InfiniBand
# The GB10 QSFP port enumerates as TWO virtual NICs (2x PCIe x4 controllers,
# ~100G each). If only one is configured, node-to-node NCCL is capped at about
# half the port: we measured 98 Gb/s single-HCA vs 161 Gb/s with both merged
# (+64%) on nccl-tests busbw. Give BOTH interfaces an IP (separate subnets) and
# MTU 9000, list both HCAs here, and set NCCL_IB_MERGE_NICS=1. Interface names
# vary per box - map them with `ibdev2netdev`.
NCCL_IB_HCA=rocepXsYfZ,rocePWpXsYfZ
NCCL_SOCKET_IFNAME=enpXsYfZnpN,enPWpXsYfZnpN
NCCL_IB_MERGE_NICS=1
# Do NOT pin NCCL_IB_GID_INDEX (changed 2026-08-21, issue #38 field report):
# GID table indexes DRIFT when interface events reshuffle the table (observed
# 3->4 within 30 minutes with both HCAs up). A pinned index that was correct at
# write time later fails on ONE HCA only ("ibv_modify_qp failed with 61") and
# hangs the TP handshake silently after model load. Modern NCCL selects the
# RoCEv2/IPv4 GID per device on its own. If your compose maps this variable,
# map it to null — an EMPTY STRING parses as 0, which selects the fe80
# link-local GID and is worse than the pin.
# NCCL_IB_GID_INDEX=3   # <- do not re-enable; kept for archaeology
NCCL_CROSS_NIC=1

# Caches / model
HF_CACHE=${HOME}/.cache/huggingface
# Optional worker-local Hugging Face cache. Use this when the worker user/path
# differs from the head node. If blank, the worker uses HF_CACHE.
WORKER_HF_CACHE=
# JIT / compile caches. MUST BE NODE-LOCAL on every node — never NFS, and never
# inside a shared HF_CACHE. Sharing it makes both ranks JIT into the same
# directories and you get, in order: a torch.compile makedirs race, DeepGEMM
# "runtime != nullptr" from half-written cubins, and an ABI-mismatched
# FlashInfer sampling.so built by one node and silently loaded by the other
# (silent because FLASHINFER_DISABLE_VERSION_CHECK=1). None of the errors name
# the cache. Credit @antoniohlc, issue #27. Default is node-local already;
# only set this if you keep HF_CACHE on NFS and want the JIT tree elsewhere.
#JIT_CACHE_DIR=${HOME}/.cache/vllm-dspark
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_HUB_DISABLE_XET=1
DSPARK_MODEL=deepseek-ai/DeepSeek-V4-Flash-DSpark
# API port (default 8888)
VLLM_PORT=8888
SERVED_MODEL_NAME=deepseek-v4-flash-dspark
# Bind to 0.0.0.0 when Hermes/OpenClaw or another machine must reach the API.
# For a head-node-only test, set this back to 127.0.0.1.
VLLM_HOST=0.0.0.0
# Explicit per-node host IPs prevent distributed vLLM/ZeroMQ from binding the
# worker to the head node's fabric address. Set these to each node's RoCE IP.
VLLM_HOST_IP=head-roce-ip
WORKER_VLLM_HOST_IP=worker-roce-ip

# Runtime image built by ./build-dspark-vllm-runtime.sh.
DSPARK_VLLM_IMAGE=vllm-dspark-runtime:dspark-nvfp4-stage-c

# Validated Keys C12 NVFP4 profile.
# Default = 1M (1048576) = the model's TRUE ceiling. config.json is YaRN with
# original_max_position_embeddings=65536 x factor 16 = 1,048,576, and
# max_position_embeddings=1048576. Keys ran 1500000 via VLLM_ALLOW_LONG_MAX_MODEL_LEN,
# which FORCES vLLM past the YaRN-calibrated range — it boots + benchmarks (see the
# 1.5M checkpoint in the README) but positions past 1M extrapolate past calibration,
# so coherent output past 1M is not guaranteed. Keep 1048576 unless deliberately
# experimenting past the ceiling.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=12
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85
# DSpark speculative tokens. 5 is the verified default: Patch 3 makes the higher
# draft depth garble-safe WITH probabilistic draft sampling (+24% over 3).
# History: k=3 was the 2026-07-03 garble-fix value, needed only while the old
# GREEDY-draft 5-token setting caused the cold-start concurrent tool-call dump.
# That constraint is gone — do not drop back to 3 for "safety"; it just costs speed.
MTP_NUM_TOKENS=5

# No sampling override. The old --override-generation-config carried
# repetition_penalty=1.05, which is a documented DSpark spec-decode crash risk
# (illegal memory access). The launcher keeps --generation-config vllm only.
# Explicit client request parameters still win. See the README "Garble fix
# (2026-07-03)" section.

# Higher-throughput short-context profile from the Keys concurrency patch:
# MAX_MODEL_LEN=200000
# MAX_NUM_SEQS=16
# VLLM_USE_B12X_WO_PROJECTION=1
#
# Conservative prior agent lane:
# MAX_MODEL_LEN=1048576
# MAX_NUM_SEQS=6
# GPU_MEMORY_UTILIZATION=0.80
#
# Context and concurrency share one KV pool. The validated C12 lane reported a
# 3.225M-token KV pool, or 2.15x maximum concurrency for 1.5M-token requests.
# Normal agent turns are much shorter than the maximum, so 12 slots are useful;
# multiple simultaneous full-context requests will still queue.

# DSpark and B12X switches from the validated 1M run.
# FlashInfer sampler is part of the 2026-07-03 DSpark garble fix.
VLLM_USE_FLASHINFER_SAMPLER=1
# CRITICAL: VLLM_USE_B12X_MOE=1 is essential for speed and is the entire speed
# difference. =1 uses the b12x Mxfp4 MoE backend (boot log
# "Using 'B12X' Mxfp4 MoE backend") for full ~50-60+ tok/s; =0 silently falls
# back to DEEPGEMM_MXFP4 and tanks decode to ~29 tok/s. Keep it 1.
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_WO_PROJECTION=1
VLLM_DSPARK_CONFIDENCE_THRESHOLD=0.0
VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
VLLM_DSPARK_LOCAL_ARGMAX=1
VLLM_DSPARK_REPLICATE_MARKOV_W1=1
VLLM_DSPARK_FUSED_MARKOV_ARGMAX=0
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK=1
VLLM_DSPARK_REFERENCE_KV_QUANT_DEQUANT=0
VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=
B12X_W4A16_TC_DECODE=0
VLLM_DSV4_B12X_COMPRESSED_MLA=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE_EXACT=0

# Image-compat notes for the dspark-nvfp4-stage-c-class image (verified 2026-07-03):
# - Do NOT set VLLM_USE_V2_MODEL_RUNNER=1; it is incompatible with DSpark
#   speculative decoding (hard reject at startup). Leave it unset/0.
# - Do NOT pass --attention-backend FLASHINFER_MLA_SPARSE_DSV4; that backend name
#   does not exist on this image (ValueError: unknown backend). Leave attention
#   AUTO so it selects the DeepSeek-V4 sparse MLA path that works with nvfp4_ds_mla.

# Runtime defaults.
# Engine-ready timeout. Stock 600 s trips torch.distributed teardown on a warm
# restart of this 155 GiB two-node load; the second startup dies with no useful
# error. 3600 matches the sparkrun profile (PR #19).
VLLM_ENGINE_READY_TIMEOUT_S=3600
# Inference-time RPC deadline (default 300s is shorter than a cold mid-inference JIT -- see #8)
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_TRITON_MLA_SPARSE=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/opt/env/bin/nvcc
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_SKIP_INIT_MEMORY_CHECK=1

# --- portability on hosts other than the author's ---
# The base image bakes the author's NIC into GLOO_SOCKET_IFNAME and
# TP_SOCKET_IFNAME. Leave these unset to inherit NCCL_SOCKET_IFNAME
# (the compose file now does that), or set them explicitly:
#GLOO_SOCKET_IFNAME=
#TP_SOCKET_IFNAME=

# Serve weights already on disk (skips the HF download path). The launcher
# scps this env file to the worker and runs both nodes with --env-file, so a
# value here reaches head and worker alike. DSPARK_MODEL must then point inside
# the mount, e.g. /models/<dir>, and must not be a symlink to a path outside it.
#LOCAL_MODELS_DIR=/data/models

# nvfp4_ds_mla gives the 1M pool; fp8_ds_mla is the conservative choice
# when 4-bit KV quality under long agentic context matters more than reach.
#KV_CACHE_DTYPE=nvfp4_ds_mla

# ---------------------------------------------------------------------------
# Live tuning as of 2026-10-06. Everything below was load-bearing on the
# running cluster and absent from this file, which means a node rebuild would
# have silently lost it. Values are from spark-45ea/spark-da08 (2x GB10, TP=2).
# ---------------------------------------------------------------------------

# Server-side web_search. THE ONLY SECRET IN THIS FILE, which is why
# .gitignore ignores .env.dspark* and keeps only this example. Leave empty
# here; without it web search degrades to a structurally valid empty answer
# rather than failing loudly.
SERPER_API_KEY=

# --- KV pool: pin the BYTES, do not tune the utilisation -------------------
# gpu_memory_utilization infers the pool from a MEASUREMENT taken after weight
# load, and two of that measurement's inputs move per run: non-torch memory,
# and vLLM's CUDAGraph estimator, which returned 0.72, 1.28 and then -0.04 GiB
# across three starts of an identical config. On the negative run it reserved
# nothing, so the actual 1.15 GiB of graphs came out of the KV pool AFTER the
# pool was sized -- an over-commit that merely looked like the best result.
#
# kv_cache_memory_bytes skips profiling entirely and takes the number verbatim
# (gpu_worker.py:370), so the pool stops moving. Proven: two cold starts gave
# 3,604,786 tokens both times while free-at-init differed by 0.12 GiB.
#
# *** BOX-SPECIFIC. RE-DERIVE, DO NOT COPY TO DIFFERENT HARDWARE. ***
# Derive it by setting VLLM_LOGGING_CONFIG_PATH below and reading the DEBUG
# line from gpu_worker.py:683, which prints two ready-to-use values plus the
# full decomposition. Re-derive after any change to the model, TP layout,
# max_num_batched_tokens, max_num_seqs, or the driver -- all of them move the
# non-KV total. Note the log message names the flag WRONG: it says
# --kv-cache-memory, the real argument is --kv-cache-memory-bytes.
#
# 23400318587 = 21.79 GiB, vLLM's own "fit into requested" suggestion.
# Plus dispram's 2.00 GiB carveout -> 23.79 GiB -> 3,604,786 tokens.
# Computed safe ceiling at today's non-torch is 21.93 GiB, so this leaves
# 0.14 GiB of headroom.
KV_CACHE_MEMORY_BYTES=23400318587

# With the pool pinned, this NO LONGER AFFECTS KV SIZE. It only has to satisfy
# the startup check free >= util*total, which RAISES rather than clamping.
# It was 0.93, where requested sat 0.07 GiB under free -- close enough that a
# marginally different init would refuse to start. 0.90 leaves ~3.8 GiB.
# DO NOT read this as a safety bound any more; the byte constant is the bound.
GPU_MEMORY_UTILIZATION=0.90

# --- 64 KiB-page kernel (kindling spark-os nvidia-64k) ---------------------
# MANDATORY on the 64k kernel: the default lazy safetensors loader copies from
# a file-backed mmap and that HANGS -- measured stuck at shard 0/48 for 260+ s
# with the GPU at 0-1%, against eager doing 48 shards in ~52 s.
# Needs patches/safetensors_e8m0_plugin, because eager's Python dtype table
# lacks F8_E8M0 and NVFP4 keeps its block scales in it.
# Leave EMPTY on a 4k kernel, where the lazy loader is correct and faster.
SAFETENSORS_LOAD_STRATEGY=eager

# Surfaces the kv-cache-memory suggestions above (they are logger.debug).
# Scoped to vllm.v1.worker.gpu_worker only; global DEBUG buries the one line.
# Safe to leave set; empty to disable.
VLLM_LOGGING_CONFIG_PATH=/opt/vllm-logging-debug.json

# --- MNT-6a protected-prompt-block cap ------------------------------------
# Divided by the number of KV managers (5 here), so 0.75 protects ~15% of the
# pool per group, giving ~932,000 tokens of retention at the current pool --
# enough to cover the measured 740,315-token session.
# REVERT SIGNAL: vllm:num_preemptions_total going non-zero. It is 0 today.
PROTECTED_FRACTION=0.75

# --- NCCL pinned-buffer reclaim (stage 1, 2026-10-05) ---------------------
# Defaults pinned 2,495,520 kB of HOST memory per rank; these cap the buffers
# and channels and bring it to ~69,332 kB at init, reclaiming ~2.31 GiB/node.
# NOTE the honest accounting: this did NOT produce the extra KV. Raising
# GPU_MEMORY_UTILIZATION is what did; the reclaim bought host headroom so the
# higher utilisation is affordable. Removing these without lowering the
# utilisation makes the box tighter than its baseline.
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
# Empty is correct here: let NCCL choose the RoCE GID rather than pinning one.
NCCL_IB_GID_INDEX=

# --- Vision-Exp model ------------------------------------------------------
HF_OVERRIDES='{"architectures":["DeepseekV4VForConditionalGeneration"]}'
COMPILATION_CONFIG='{"max_cudagraph_capture_size":72}'
