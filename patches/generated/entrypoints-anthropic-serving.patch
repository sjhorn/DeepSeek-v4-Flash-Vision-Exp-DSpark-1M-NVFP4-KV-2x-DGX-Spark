+def _system_text(system: Any) -> str:
+    if isinstance(system, str):
+        return system
+    if isinstance(system, list):
+        return "".join(
+            b.text if getattr(b, "text", None) else (b.get("text", "") if isinstance(b, dict) else "")
+            for b in system
+        )
+    return ""
+
