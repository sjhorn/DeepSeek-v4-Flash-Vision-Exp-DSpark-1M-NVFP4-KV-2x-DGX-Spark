+# ---------------------------------------------------------------------------
+# MNT-10 (2026-09-21): make `long_prefill_token_threshold` live-tunable.
+#
+# WHY.  vLLM's V1 scheduler walks `self.running` IN ORDER against ONE shared
+# `token_budget` (= max_num_batched_tokens, 8192 here).  A request still in
+# chunked prefill takes `min(remaining_prefill, token_budget)` -- i.e. ALL of
+# it -- the `while ... and token_budget > 0` guard then fails, and every request
+# behind it is scheduled ZERO tokens that step.  A decoding sequence needs about
+# six.  It gets none.
+#
+# Measured on our own traffic 2026-09-20/21 (13h, 696 windows): single-request
+# decode is healthy at 36 tok/s median, but aggregate falls to 0.2-2 tok/s for
+# minutes at a time whenever a ~186K-token prompt is prefilling -- at 44-71% KV,
+# with ZERO preemptions and a flat ~94% prefix hit rate.  The tell in the log is
+# `Drafted: 10 tokens` across a 10-second window: at k=5 that is two engine steps
+# in ten seconds.  See docs/local/status/INCIDENTS.md.
+#
+# Stock already has the right knob -- `long_prefill_token_threshold` caps how
+# much ONE request may take per step, leaving the rest of the budget for the
+# decoders behind it -- but it defaults to 0 (disabled) and is BOOT-ONLY.
+#
+# WHY GATE IT.  The scheduler re-reads this field on EVERY step, so nothing but
+# the config plumbing forces a restart.  The right value is genuinely unknown:
+# MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks#110 (our exact hardware) fixed a
+# 440s freeze with 1024 against MNBT=2048, while vllm#54919 (2-node DGX Spark
+# TP2) reports 4096 against MNBT=8192 was NOT enough.  Gating it turns a
+# 250-600s cold boot per arm into a live flip, which is the same trade that made
+# MNT-8/MNT-9 affordable to test.
+#
+# Precedence, matching patch6: env var VLLM_LONG_PREFILL_TOKEN_THRESHOLD wins,
+# then the flags file, then whatever --long-prefill-token-threshold set at boot
+# (2048 in docker-compose.dspark.yml).  So the CLI value is the floor you get
+# with no flags file at all, and a cleared /var/tmp cannot silently disable it.
+#
+# Roll back by removing the bind-mount line for this file from the compose.
+# ---------------------------------------------------------------------------
+# The flags file as seen FROM INSIDE THE CONTAINER. The host keeps it at
+# /var/tmp/vllm-kv-flags/ and the compose mounts that directory read-only at
+# /etc/vllm-kv-flags. Using the host path here was a real bug on 2026-09-21: the
+# gate read a path that does not exist in the container, silently fell through to
+# the boot value, and made an A/B read as "no difference" in both arms. Keep this
+# identical to patch6's _FLAGS_PATH, env override included.
+_MNT10_FLAGS = os.environ.get("VLLM_KV_FLAGS_FILE", "/etc/vllm-kv-flags/flags.json")
+_mnt10_cache: "tuple[float, dict]" = (0.0, {})
+_mnt10_logged: "set[int]" = set()
+_mnt10_armed_logged = False
+
+
+def _mnt10_flags() -> dict:
+    """Re-read the flags file at most once a second.
+
+    A half-written file reads as bad JSON; we return the LAST GOOD value rather
+    than {} so a mid-run rewrite cannot silently drop the cap for a step.  That
+    is the opposite of the kv-flags convention on purpose -- here "no opinion"
+    must fall through to the boot value, not to 0/disabled.
+    """
+    global _mnt10_cache
+    now = time.monotonic()
+    ts, cached = _mnt10_cache
+    if now - ts < 1.0:
+        return cached
+    try:
+        with open(_MNT10_FLAGS) as fh:
+            data = json.load(fh)
+        if not isinstance(data, dict):
+            data = cached
+    except Exception:
+        data = cached
+    _mnt10_cache = (now, data)
+    return data
+
+
+def _mnt10_arm_log(boot_value: int) -> None:
+    """Say ONCE, at the first scheduling decision, that the gate is executing.
+
+    Without this the patch is undetectable when it works: the override log only
+    fires when a flag or env var actually overrides, so a gate reading the wrong
+    path looks exactly like a gate with nothing to do. That is precisely the bug
+    that made the first A/B read as "no difference" in both arms.
+    """
+    global _mnt10_armed_logged
+    if _mnt10_armed_logged:
+        return
+    _mnt10_armed_logged = True
+    logger.info(
+        "MNT-10: armed. Per-request per-step cap = %d tokens (boot value); "
+        "flags file %s (%s). Budget max_num_batched_tokens is the shared pool "
+        "this cap carves a request's share out of.",
+        boot_value,
+        _MNT10_FLAGS,
+        "present" if os.path.exists(_MNT10_FLAGS) else "ABSENT — live override unavailable",
+    )
+
+
+def _mnt10_threshold(boot_value: int) -> int:
+    """The per-step cap for a single request, or 0 to disable the cap.
+
+    `boot_value` is `scheduler_config.long_prefill_token_threshold`, i.e. what
+    --long-prefill-token-threshold set at boot.  Returned unchanged unless an
+    env var or the flags file overrides it.
+    """
+    _mnt10_arm_log(boot_value)
+    raw = os.environ.get("VLLM_LONG_PREFILL_TOKEN_THRESHOLD")
+    if raw is None:
+        raw = _mnt10_flags().get("long_prefill_token_threshold")
+    if raw is None:
+        return boot_value
+    try:
+        value = int(raw)
+    except (TypeError, ValueError):
+        return boot_value
+    if value < 0:
+        return boot_value
+    if value not in _mnt10_logged:
+        _mnt10_logged.add(value)
+        logger.info(
+            "MNT-10: long_prefill_token_threshold overridden to %d "
+            "(boot value %d) -- one request may take at most this many tokens "
+            "per step, leaving the rest of the budget for decodes behind it",
+            value,
+            boot_value,
+        )
+    return value
+
